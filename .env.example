# ==============================================================================
# ENTERPRISE IAM SECURITY PORTAL - ENVIRONMENT TEMPLATE (.env.example)
# Duplicate this file to .env and configure for your environment.
# ==============================================================================

# Database Infrastructure (MySQL / MariaDB via XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=iam_secure_portal
DB_USERNAME=root
DB_PASSWORD=

# Application Core Configuration (HTTPS & Enterprise Domain)
APP_NAME="Enterprise IAM SOC Portal"
APP_ENV=production
APP_DEBUG=false
APP_DOMAIN=iam.secure-defense.internal
APP_URL=https://iam.secure-defense.internal
FORCE_HTTPS=true

# AI Sentinel Anomaly Detection Parameters
SENTINEL_MAX_FAILURES_WINDOW=3
SENTINEL_WINDOW_MINUTES=15
SENTINEL_MAX_IP_SWITCHES=2
